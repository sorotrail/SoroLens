# Which backend SoroLens reads events from.
#   rpc        standalone: poll Stellar RPC and store events in Postgres
#   sorotrail  upstream:   read from a SoroTrail indexer's HTTP API
SOURCE_MODE=rpc

# --- Standalone mode (SOURCE_MODE=rpc) ---------------------------------------
# Stellar RPC endpoint. Point this at a provider URL for mainnet.
RPC_URL=https://soroban-testnet.stellar.org
# Postgres connection string. Required in standalone mode.
DATABASE_URL=postgres://sorolens:sorolens@localhost:5432/sorolens?sslmode=disable
# How long to sleep between polls once caught up to the chain tip.
POLL_INTERVAL=5s
# Comma-separated contract IDs to watch. Empty ingests every contract event.
WATCHED_CONTRACTS=
# Force a cold start from a specific ledger. Leave unset to reach back
# RETENTION_LEDGERS from the current tip.
# START_LEDGER=
# Cold-start reach-back in ledgers (~24h at 5s per ledger).
RETENTION_LEDGERS=17280

# --- Upstream mode (SOURCE_MODE=sorotrail) -----------------------------------
# Base URL of a SoroTrail indexer. Required in upstream mode.
# SOROTRAIL_URL=http://localhost:8080

# --- Shared -------------------------------------------------------------------
HTTP_ADDR=:8080
LOG_LEVEL=info

# --- Network (standalone mode) --------------------------------------------
# Which Stellar network the RPC endpoint belongs to. A network's passphrase
# is its identity: SoroLens verifies at startup that the endpoint belongs to
# the configured network and refuses to start on a mismatch, so a mainnet
# endpoint behind testnet configuration fails fast instead of quietly
# showing the wrong chain's activity.
#   testnet    (default) | mainnet | futurenet | custom (private network)
NETWORK=testnet
# Override the passphrase (e.g. a local standalone quickstart network).
# NETWORK_PASSPHRASE=Standalone Network ; February 7th 1974 at 8:37:19 PM

# --- Observability ---------------------------------------------------------
# Prometheus metrics are served on /metrics; no configuration needed.

# --- CORS -------------------------------------------------------------------
# Comma-separated allow-list of browser Origins that may call the API
# cross-origin. Empty (default) disables CORS — SoroLens's own UI is
# same-origin and never needs it. "*" allows any origin, reasonable for a
# public read-only API serving chain-public data.
# CORS_ALLOWED_ORIGINS=https://explorer.example
